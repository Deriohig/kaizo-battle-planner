# Copy to deploy/.env and fill in. Never commit .env.

# The domain the site answers on, pointed at this server (an A or AAAA record). Caddy gets its HTTPS certificate.
# With no domain, the server's IP as an sslip.io name works the same: 203-0-113-7.sslip.io for 203.0.113.7.
# "localhost" tries the stack on your own machine with Caddy's local certificate.
PKP_DOMAIN=

# The site password: visitors sign in on the planner's own sign-in page (with an optional name, which the log keeps,
# so ask people to type theirs). Leave empty for a public site. Only safe over HTTPS, which Caddy gives. Compose reads `$` and ` #`
# in this file specially: wrap a password holding them in single quotes, as PKP_PASSWORD='pa$$ #word'.
PKP_PASSWORD=

# Optional: the version health and config show (a tag or commit), set when the image is built.
# PKP_VERSION=

# Optional: how much of the trainer AI's odds the site shows (and sends: the network tab learns no more than the page).
#   full       every exact probability (the default)
#   likeliest  their likeliest move by name, ties named together, and the likeliest send-in marked; no percentages
#   ranked     their moves in order of likelihood, ties shown as equal; no percentages
#   off        no AI information at all; damage, KO chances, crit figures and speed order still show
# Anything else stops the server with one line. Restart the stack after changing it (docker compose up -d).
# PKP_AI_ODDS=likeliest

# Optional: where both containers log. The default, journald, keeps the logs across redeploys; a machine without
# journald (Docker Desktop) needs json-file.
# PKP_LOG_DRIVER=json-file
